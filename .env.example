# Server address built into the app. The login screen uses it by default (it can still be changed there).
# Copy to .env.local for development; for release builds set it to your https:// server, e.g. in
# .env.production or as an EAS environment variable. It is public (visible in the app), never put secrets here.

# Local backend (sallagrazhdaBackend: docker compose up -d). For a phone on the same Wi-Fi use http://<computer IP>:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
