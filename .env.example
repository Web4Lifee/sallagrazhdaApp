# Optional: copy to .env.local to use a local backend instead of the hosted one in .env.
# .env.local wins over .env (and git ignores it). Release builds only accept https:// addresses.

# Local backend (sallagrazhdaBackend: docker compose up -d). On a phone in Expo Go, localhost is
# pointed at the computer Expo runs on automatically.
EXPO_PUBLIC_API_URL=http://localhost:3000
